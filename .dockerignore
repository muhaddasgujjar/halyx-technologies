# The agent image needs three files. Everything else is the Next.js app, the
# local virtualenv, or a secret — and the largest of those would otherwise be
# uploaded to the builder on every deploy.

.venv/
__pycache__/
*.py[cod]

node_modules/
.next/
.git/
.vercel/

# Secrets reach the worker as environment variables from the host, never baked
# into a layer. An image carrying .env.local is a credential you cannot rotate
# out of a registry.
.env
.env.*
!.env.example

app/
components/
lib/
public/
scripts/
docs/
*.md
*.png
*.json
!requirements.txt
next.config.ts
tsconfig*.json
