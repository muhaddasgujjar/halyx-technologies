{
  "name": "halyx-technologies",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing homepage for Halyx Technologies — an applied-AI and product-engineering studio.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-css-keyframes.mjs && node scripts/check-synonym-keys.mjs && node scripts/check-react-keys.mjs && node scripts/check-i18n.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:css": "node scripts/check-css-keyframes.mjs",
    "check:synonyms": "node scripts/check-synonym-keys.mjs",
    "check:keys": "CHECK_KEYS_VERBOSE=1 node scripts/check-react-keys.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:translate": "node scripts/translate-copy.mjs",
    "i18n:build": "node scripts/i18n-extract.mjs && node scripts/translate-copy.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "d3-geo": "^3.1.1",
    "groq-sdk": "^1.6.0",
    "next": "^16.3.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/topojson-client": "^3.1.5",
    "typescript": "5.7.3"
  }
}
