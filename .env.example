# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender. `onboarding@resend.dev` is Resend's sandbox address: it needs no DNS
# setup, but it can ONLY deliver to your own Resend account email — which is
# what CONTACT_TO is below, so the notification works out of the box.
#
# Once halyx.tech is verified in the Resend dashboard, switch to your own domain:
#   CONTACT_FROM="Halyx Technologies <hello@halyx.tech>"
CONTACT_FROM="Halyx Technologies <onboarding@resend.dev>"

# Where enquiries land. Comma-separate for several recipients.
CONTACT_TO=halyxtechnologies@gmail.com

# Send an automatic "we got your brief" reply to the enquirer.
# Requires a VERIFIED sending domain in CONTACT_FROM — the sandbox sender cannot
# email arbitrary addresses, so leave this off until halyx.tech is verified.
CONTACT_ACK=false

# Canonical public URL. Drives metadata, robots.txt, the sitemap and JSON-LD.
# Leave UNSET on preview deploys: robots.txt then returns a blanket disallow so
# a staging URL can never be indexed. On Vercel this is auto-detected from
# VERCEL_URL when unset, so only production needs it.
NEXT_PUBLIC_SITE_URL=https://www.halyxtechnologies.com

# ─── Halyx AI assistant (/api/chat) ────────────────────────────────────────
# The assistant needs at least one provider key. With neither, /api/chat
# returns 503 and the chat dock falls back to the canned matcher in lib/kb.ts.

# Groq — fast, and what this deployment runs on.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq retires model ids on a rolling schedule and does NOT keep the old id
# working — llama-3.3-70b-versatile and llama-3.1-8b-instant were both shut
# down on 2026-08-16. The default in lib/rag/providers/groq.ts is
# openai/gpt-oss-120b (production, tool use, 131K context). Override here when
# that one is retired; GET /api/chat reports whether the configured id is still
# in Groq's live catalogue.
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic — the higher-quality path, and the only one with prompt caching.
# Optional. When both keys are set, Claude is used and Groq becomes the
# automatic fallback if Claude fails before any text has streamed.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-opus-5

# Pin one provider instead of auto-selecting: "groq" or "anthropic".
# A pinned provider disables failover — the choice is treated as deliberate.
# CHAT_PROVIDER=groq

# ─── Voice agent (/api/voice/*) ────────────────────────────────────────────
# The Halyx AI console on the homepage. Both ends of the voice loop run on the
# GROQ_API_KEY above — there is no separate key and no separate vendor.
#
#   mic ─▶ transcribe ─▶ /api/chat ─▶ speak ─▶ speaker
#
# Speech in. Groq's fastest Whisper; real-time is the whole point.
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Speech out. Replaced `playai-tts`, which Groq retired on 2025-12-31.
#
# HEADS UP: Groq gates this model behind a one-time, per-organisation terms
# acceptance. Until an org admin accepts it at
# https://console.groq.com/playground?model=canopylabs/orpheus-v1-english
# every synthesis request comes back 400 `model_terms_required`, /api/voice/speak
# answers 409, and the console speaks through the browser's own synthesiser
# instead. Nothing breaks and no redeploy is needed — accept the terms and the
# same code picks up the better voice on the next request.
# GROQ_TTS_MODEL=canopylabs/orpheus-v1-english

# Orpheus voice name. Warm and even-paced, which suits a receptionist role.
# GROQ_TTS_VOICE=tara
