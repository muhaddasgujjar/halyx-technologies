# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender. `onboarding@resend.dev` is Resend's sandbox address: it needs no DNS
# setup, but it can ONLY deliver to your own Resend account email — which is
# what CONTACT_TO is below, so the notification works out of the box.
#
# Once halyx.tech is verified in the Resend dashboard, switch to your own domain:
#   CONTACT_FROM="Halyx Technologies <hello@halyx.tech>"
CONTACT_FROM="Halyx Technologies <onboarding@resend.dev>"

# Where enquiries land. Comma-separate for several recipients.
CONTACT_TO=halyxtechnologies@gmail.com

# Send an automatic "we got your brief" reply to the enquirer.
# Requires a VERIFIED sending domain in CONTACT_FROM — the sandbox sender cannot
# email arbitrary addresses, so leave this off until halyx.tech is verified.
CONTACT_ACK=false

# Canonical public URL. Drives metadata, robots.txt, the sitemap and JSON-LD.
# Leave UNSET on preview deploys: robots.txt then returns a blanket disallow so
# a staging URL can never be indexed. On Vercel this is auto-detected from
# VERCEL_URL when unset, so only production needs it.
NEXT_PUBLIC_SITE_URL=https://halyx.tech
